# Salin file ini ke .env lalu sesuaikan.
# Bila tidak diisi, nilai di bawah mengikuti default "docker compose up db".

DB_HOST=localhost
DB_PORT=5432
DB_USER=financeapp
DB_PASSWORD=financeapp
DB_NAME=finance_app

# SSL: "require" memaksa SSL, "disable" menonaktifkan.
# Kosongkan bila tidak yakin: SSL otomatis aktif untuk host non-lokal (mis. Supabase)
# dan otomatis nonaktif untuk localhost/127.0.0.1.
# DB_SSL=

# Kunci untuk menandatangani cookie session (login).
# WAJIB diisi di Vercel: string acak minimal 32 karakter.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# (Opsional) ID user demo dari server/seed.sql — tidak dipakai lagi oleh API,
# dibiarkan agar kompatibel dengan konfigurasi lama.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Scan Resi - Groq (opsional; tanpa API key ekstraksi memakai mock)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
